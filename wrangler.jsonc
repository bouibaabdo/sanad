{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sanad-remote",
  "main": "./cloudflare/worker.mjs",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/"]
  },
  "durable_objects": {
    "bindings": [{ "name": "SIGNAL_ROOMS", "class_name": "SignalRoom" }]
  },
  "exports": {
    "SignalRoom": { "type": "durable-object", "storage": "sqlite" }
  }
}
